# Wzor pliku arbomachine.env dla wspolnego serwera (skopiuj poza Gita, chmod 600, uzupelnij). Bez prawdziwych wartosci!
# Nazwy zmiennych zgodne z kontraktem wspolnego wdrozenia ArboMachine + ArnoCRM.

# --- Obraz (tag z deploy/build-image.sh) - uzywany przez compose, nie przez aplikacje ---
ARBOMACHINE_IMAGE_TAG=0.0.1-SNAPSHOT-<commit>

# --- PostgreSQL 18.6 (wspolny serwer, osobna baza i rola) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arbomachine
DB_SCHEMA=arbomachine
DB_USERNAME=arbomachine
DB_PASSWORD=<haslo-roli-arbomachine>
# Opcjonalnie: DB_POOL_MAX_SIZE=4, DB_POOL_MIN_IDLE=1, FLYWAY_BASELINE_ON_MIGRATE=false

# --- SMTP (wspolne konto Gmail, STARTTLS 587) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mailapptest75@gmail.com
SMTP_APP_PASSWORD=<haslo-aplikacji-gmail>

# --- JWT (min. 32 losowe znaki, np. openssl rand -base64 48) ---
JWT_SECRET=<losowy-sekret>

# --- Adres publiczny (HTTPS przez Caddy) - linki w mailach ---
APP_PUBLIC_BASE_URL=https://<domena-arbomachine>
APP_REGISTRATION_EMAIL_CONFIRMATION_REQUIRED=true

# --- Tryb demo (wejscie ze strony logowania bez konta, przykladowe projekty tylko do odczytu) ---
# true = przy starcie zakladane jest konto demo i (raz) dane pokazowe (~200 drzew, ~7 MB zdjec-ilustracji).
DEMO_ENABLED=true
# Rejestracja kont urzednika - chwilowo zamknieta.
REGISTRATION_OFFICIAL_ENABLED=false

# --- Web Push (stale klucze VAPID, np. npx web-push generate-vapid-keys) - zalecane ---
APP_PUSH_VAPID_PUBLIC_KEY=<klucz-publiczny-base64url>
APP_PUSH_VAPID_PRIVATE_KEY=<klucz-prywatny-base64url>
APP_PUSH_VAPID_SUBJECT=mailto:mailapptest75@gmail.com

# --- Dokument PDF: 1 generowanie naraz (ochrona przed OOM), kolejne czeka max 120 s ---
PDF_MAX_CONCURRENT_GENERATIONS=1
PDF_MAX_WAIT_SECONDS=120

# --- Tylko dla skryptu bazy (kontener postgres przy pierwszej inicjalizacji): to samo co DB_PASSWORD ---
# ARBOMACHINE_DB_PASSWORD=<haslo-roli-arbomachine>
