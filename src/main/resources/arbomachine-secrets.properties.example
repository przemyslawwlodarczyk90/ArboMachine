# Skopiuj do arbomachine-secrets.properties (ten sam katalog) i uzupelnij.
spring.mail.username=twoj_adres@gmail.com
# Haslo aplikacji Gmail (16 znakow), nie haslo do konta Google.
spring.mail.password=xxxx xxxx xxxx xxxx
# Dowolny dlugi, losowy ciag (min. 32 znaki) - klucz podpisujacy tokeny JWT.
auth.jwt.secret=zmien_mnie_na_dlugi_losowy_sekret
# Odkomentuj, jesli SMTP nie dziala - konta beda aktywowane od razu, bez maila.
# app.registration.email-confirmation-required=false
